        "type": "function",
        "z": "72b54a41227aca2a",
        "name": "Update Scores",
        "func": "let scores = flow.get(\"scores\") || {\n    P1: 0,\n    P2: 0,\n    P3: 0\n};\n\nif (msg.payload === \"Player 1\") {\n    scores.P1++;\n}\nelse if (msg.payload === \"Player 2\") {\n    scores.P2++;\n}\nelse if (msg.payload === \"Player 3\") {\n    scores.P3++;\n}\n\nflow.set(\"scores\", scores);\n\nmsg.payload = scores;\n\nreturn msg;",
