    {
        "id": "11d47a9251596f78",
        "type": "function",
        "z": "72b54a41227aca2a",
        "name": "Questions",
        "func": "let questions = [\n\n    // السؤال 1\n    {\n        q: \"السؤال الأول ما هو نظام التشغيل مفتوح المصدر؟\",\n        A: \"Windows\",\n        B: \"macOS\",\n        C: \"iOS\",\n        D: \"Linux\",\n        correct: \"D\"\n    },\n\n    // السؤال 2\n    {\n        q: \"السؤال الثاني أي لغة برمجة تستخدم لتطوير تطبيقات Android؟\",\n        A: \"Python\",\n        B: \"Swift\",\n        C: \"Java\",\n        D: \"PHP\",\n        correct: \"C\"\n    },\n\n    // السؤال 3\n    {\n        q: \"السؤال الثالث ما هي لغة ترميز النصوص التشعبية؟\",\n        A: \"HTML\",\n        B: \"JavaScript\",\n        C: \"CSS\",\n        D: \"PHP\",\n        correct: \"A\"\n    },\n\n    // السؤال 4\n    {\n        q: \"السؤال الرابع أي من هذه ليست لغة برمجة؟\",\n        A: \"Python\",\n        B: \"Java\",\n        C: \"HTML\",\n        D: \"C++\",\n        correct: \"C\"\n    },\n\n    // السؤال 5\n    {\n        q: \"السؤال الخامس ما هو بروتوكول نقل النص التشعبي؟\",\n        A: \"FTP\",\n        B: \"HTTP\",\n        C: \"SMTP\",\n        D: \"SSH\",\n        correct: \"B\"\n    },\n\n    // السؤال 6\n    {\n        q: \"السؤال السادس أي من هذه قواعد بيانات علائقية؟\",\n        A: \"MongoDB\",\n        B: \"MySQL\",\n        C: \"Redis\",\n        D: \"Firebase\",\n        correct: \"B\"\n    },\n\n    // السؤال 7\n    {\n        q: \"السؤال السابع ما هو الـ IP المعروف باسم localhost؟\",\n        A: \"192.168.1.1\",\n        B: \"10.0.0.1\",\n        C: \"127.0.0.1\",\n        D: \"172.16.0.1\",\n        correct: \"C\"\n    },\n\n    // السؤال 8\n    {\n        q: \"السؤال الثامن أي من هذه ليس نظام تشغيل للهواتف؟\",\n        A: \"iOS\",\n        B: \"Android\",\n        C: \"Windows Phone\",\n        D: \"Linux Desktop\",\n        correct: \"D\"\n    },\n\n    // السؤال 9\n    {\n        q: \"السؤال التاسع تستخدم لغة الـ CSS لـ؟\",\n        A: \"تصميم الواجهات\",\n        B: \"البرمجة المنطقية\",\n        C: \"قواعد البيانات\",\n        D: \"الذكاء الاصطناعي\",\n        correct: \"A\"\n    },\n\n    // السؤال 10\n    {\n        q: \"السؤال العاشر أي من هذه ليس لغة برمجة نصية؟\",\n        A: \"JavaScript\",\n        B: \"Python\",\n        C: \"PHP\",\n        D: \"C#\",\n        correct: \"D\"\n    },\n\n    // السؤال 11\n    {\n        q: \"السؤال الحادي عشر ما هو بروتوكول البريد الإلكتروني؟\",\n        A: \"SMTP\",\n        B: \"HTTP\",\n        C: \"FTP\",\n        D: \"TCP\",\n        correct: \"A\"\n    },\n\n    // السؤال 12\n    {\n        q: \"السؤال الثاني عشر أي من هذه هو إطار عمل جافا سكريبت؟\",\n        A: \"React\",\n        B: \"Django\",\n        C: \"Laravel\",\n        D: \"Spring\",\n        correct: \"A\"\n    },\n\n    // السؤال 13\n    {\n        q: \"السؤال الثالث عشر ما هي وحدة المعالجة المركزية؟\",\n        A: \"الذاكرة\",\n        B: \"القرص الصلب\",\n        C: \"المعالج\",\n        D: \"كارت الشاشة\",\n        correct: \"C\"\n    },\n\n    // السؤال 14\n    {\n        q: \"السؤال الرابع عشر أي من هذه ليس نوع من الذاكرة؟\",\n        A: \"RAM\",\n        B: \"ROM\",\n        C: \"CPU\",\n        D: \"Cache\",\n        correct: \"C\"\n    },\n\n    // السؤال 15\n    {\n        q: \"السؤال الخامس عشر ما هو الـ DNS؟\",\n        A: \"خادم أسماء النطاقات\",\n        B: \"بروتوكول نقل\",\n        C: \"لغة برمجة\",\n        D: \"نظام تشغيل\",\n        correct: \"A\"\n    },\n\n    // السؤال 16\n    {\n        q: \"السؤال السادس عشر أي من هذه يستخدم للتحكم بالإصدارات؟\",\n        A: \"Git\",\n        B: \"Docker\",\n        C: \"Kubernetes\",\n        D: \"Jenkins\",\n        correct: \"A\"\n    },\n\n    // السؤال 17\n    {\n        q: \"السؤال السابع عشر ما هو نظام التشغيل من Apple؟\",\n        A: \"Windows\",\n        B: \"Linux\",\n        C: \"macOS\",\n        D: \"Android\",\n        correct: \"C\"\n    },\n\n    // السؤال 18\n    {\n        q: \"السؤال الثامن عشر أي من هذه ليس نوع من قواعد البيانات؟\",\n        A: \"علائقية\",\n        B: \"وثائقية\",\n        C: \"بيانية\",\n        D: \"خطية\",\n        correct: \"D\"\n    },\n\n    // السؤال 19\n    {\n        q: \"السؤال التاسع عشر ما هو الـ API؟\",\n        A: \"واجهة برمجة التطبيقات\",\n        B: \"لغة برمجة\",\n        C: \"نظام تشغيل\",\n        D: \"خادم ويب\",\n        correct: \"A\"\n    },\n\n    // السؤال 20\n    {\n        q: \"السؤال العشرون أي من هذه هو نظام إدارة محتوى؟\",\n        A: \"WordPress\",\n        B: \"React\",\n        C: \"Angular\",\n        D: \"Node.js\",\n        correct: \"A\"\n    }\n\n];\n\n\n// ==============================\n// بدء الأسئلة\n// ==============================\nif (msg.payload === \"START\") {\n\n    flow.set(\"questionsStarted\", true);\n    flow.set(\"questionIndex\", 0);\n\n}\n\n\nif (flow.get(\"questionsStarted\") !== true) {\n\n    msg.payload = \"\";\n    return msg;\n\n}\n\n\n// ==============================\n// معرفة رقم السؤال الحالي\n// ==============================\nlet index = flow.get(\"questionIndex\") || 0;\n\n\n// ==============================\n// انتهاء جميع الأسئلة\n// ==============================\nif (index >= questions.length) {\n\n    flow.set(\"questionsStarted\", false);\n\n    msg.payload = \"انتهت الأسئلة 🎉\";\n\n    return msg;\n\n}\n\n\n// ==============================\n// الحصول على السؤال الحالي\n// ==============================\nlet item = questions[index];\n\n\n// ==============================\n// عرض السؤال\n// السؤال في سطر\n// الإجابات في السطر التالي\n// ==============================\nmsg.payload =\n    \"<div style='text-align:right; width:100%; font-size:22px; font-weight:bold;'>\" +\n    item.q +\n    \"</div>\" +\n    \"<div style='margin-top:15px;'>\" +\n    \"A: \" + item.A + \"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\" +\n    \"B: \" + item.B + \"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\" +\n    \"C: \" + item.C + \"&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;\" +\n    \"D: \" + item.D +\n    \"</div>\";\n\n\n// ==============================\n// حفظ الإجابة الصحيحة للسؤال الحالي\n// ==============================\nflow.set(\"correctAnswer\", item.correct);\nnode.warn(\"Correct Answer = \" + item.correct);\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
