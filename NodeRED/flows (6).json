        "type": "function",
        "z": "72b54a41227aca2a",
        "name": "Check Answer",
        "func": "let answer = String(msg.payload).trim();\n\nlet correctAnswer = flow.get(\"correctAnswer\");\n\nif (answer === correctAnswer) {\n\n    msg.payload = \"✅ الإجابة صحيحة\";\n\n} else {\n\n    msg.payload = \"❌ الإجابة خاطئة\";\n\n}\n\nreturn [msg, null];",
