        "type": "function",
        "z": "72b54a41227aca2a",
        "name": "Convert ESP32 Player",
        "func": "let p = Number(msg.payload);\n\nif (p === 1) {\n    msg.payload = \"P1\";\n} else if (p === 2) {\n    msg.payload = \"P2\";\n} else if (p === 3) {\n    msg.payload = \"P3\";\n} else {\n    return null;\n}\n\nreturn msg;",
