    {
        "id": "696d4cd71972b047",
        "type": "function",
        "z": "72b54a41227aca2a",
        "name": "First Player Lock",
        "func": "let locked = flow.get(\"roundLocked\") || false;\n\n// إذا لاعب سبق وضغط، تجاهل أي لاعب آخر\nif (locked === true) {\n    return null;\n}\n\n// أول لاعب فقط يتم تسجيله\nflow.set(\"roundLocked\", true);\n\nif (msg.payload === \"P1\") {\n    msg.payload = \"Player 1\";\n}\nelse if (msg.payload === \"P2\") {\n    msg.payload = \"Player 2\";\n}\nelse if (msg.payload === \"P3\") {\n    msg.payload = \"Player 3\";\n}\nelse {\n    return null;\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
